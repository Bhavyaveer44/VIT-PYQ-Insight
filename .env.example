# Local Ollama server and models (used by PDF/PPT Q&A and optional extraction)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=koesn/llama3-8b-instruct:latest
OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed

# Optional MathPix OCR credentials
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Optional question extraction behavior
USE_LLM_CLEANING=false
USE_MATHPIX=false
